# =====================================================================
#  APACHE AYARLARI – Çılgın Yazılım PHP Başlangıç Şablonu
#  cilginyazilim.com
# ---------------------------------------------------------------------
#  Bu dosya olmasa da uygulama çalışır (adresler "index.php?r=..."
#  biçimindedir). Ancak buradaki kurallar ek güvenlik sağlar.
#  Nginx kullanıyorsanız bu dosya YOK SAYILIR; aynı korumaları
#  sunucu bloğunuzda tanımlamanız gerekir (README'ye bakın).
# =====================================================================

Options -Indexes
DirectoryIndex index.php

# ---------------------------------------------------------------------
#  1) HASSAS DOSYALARA ERİŞİM ENGELİ
# ---------------------------------------------------------------------
#  .env dosyası veritabanı şifrenizi içerir. Tarayıcıdan okunabilirse
#  sunucunuz ele geçirilir.
<FilesMatch "^\.env|^\.env\..*|composer\.(json|lock)$|\.(sql|md|log|ini|sh|bak|swp|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------
#  2) TEMİZ ADRESLER (isteğe bağlı)
# ---------------------------------------------------------------------
#  Varsayılan olarak DEVRE DIŞIDIR; uygulama "index.php?r=panel"
#  biçimini kullanır ve hiçbir sunucu ayarı gerektirmez.
#
#  Temiz adres istiyorsanız:
#    1) Aşağıdaki RewriteRule satırının başındaki # işaretini kaldırın
#    2) .env dosyasında APP_PRETTY_URLS=true yapın
#    3) Apache'de mod_rewrite ve AllowOverride All açık olmalıdır
<IfModule mod_rewrite.c>
    RewriteEngine On

    # "kurulum/" ve gerçek dosya/klasörlere dokunma.
    RewriteCond %{REQUEST_URI} !^/kurulum
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # RewriteRule ^(.*)$ index.php?r=$1 [QSA,L]
</IfModule>

# ---------------------------------------------------------------------
#  3) GÜVENLİK BAŞLIKLARI (yedek katman)
# ---------------------------------------------------------------------
#  PHP zaten bu başlıkları gönderiyor (App\Core\Response). Buradaki
#  tanımlar, PHP çalışmadan servis edilen statik dosyaları da kapsar.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------
#  4) İSTEMCİ ÖNBELLEĞİ (statik dosyalar)
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------
#  5) SIKIŞTIRMA
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
