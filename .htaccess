# =====================================================================
#  APACHE AYARLARI – Çılgın Yazılım PHP Başlangıç Şablonu
#  cilginyazilim.com
# ---------------------------------------------------------------------
#  Bu dosya olmasa da uygulama çalışır (adresler "index.php?r=..."
#  biçimindedir). Ancak buradaki kurallar ek güvenlik sağlar.
#  Nginx kullanıyorsanız bu dosya YOK SAYILIR; aynı korumaları
#  sunucu bloğunuzda tanımlamanız gerekir (README'ye bakın).
# =====================================================================

Options -Indexes
DirectoryIndex index.php

# ---------------------------------------------------------------------
#  1) HASSAS DOSYALARA ERİŞİM ENGELİ
# ---------------------------------------------------------------------
#  .env dosyası veritabanı şifrenizi içerir. Tarayıcıdan okunabilirse
#  sunucunuz ele geçirilir.
#  "cy" konsol betiğinin uzantısı yoktur; Apache onu PHP olarak
#  çalıştırmaz, DÜZ METİN olarak servis ederdi. Erişimi kapatıyoruz.
<FilesMatch "^\.env|^\.env\..*|^cy$|composer\.(json|lock)$|\.(sql|md|log|ini|sh|bak|swp|dist|stub)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------
#  2) TEMİZ ADRESLER (SEO uyumlu)
# ---------------------------------------------------------------------
#  /panel/ayarlar          ✔  temiz
#  /index.php?r=panel/... ✘  eski biçim
#
#  Kural AÇIKTIR. mod_rewrite yoksa ya da AllowOverride kapalıysa
#  uygulama kendini otomatik olarak eski biçime düşürür — hiçbir şey
#  bozulmaz (bkz. app/Support/helpers.php → url()).
#
#  Alt klasörde çalışıyorsanız (ör. /cy-php-starter/) RewriteBase'i
#  açmanız GEREKMEZ: kural göreli çalışır ve uygulama kendi taban
#  yolunu SCRIPT_NAME üzerinden bulur.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sondaki bölü işaretini temizle: /panel/ayarlar/ → /panel/ayarlar
    # (aynı içeriğin iki adresi olması SEO'da yinelenen içerik sayılır)
    #
    # VİTRİN İSTİSNASI: uygulama cilginyazilim.com/kutuphane/uygulama/<klasor>/
    # adresinden de açılıyor. Kök .htaccess o adrese eğik çizgiyi EKLER, bu kural
    # SİLER; ikisi karşılıklı 301 üretip isteği CI4'e düşürüyor ve ziyaretçi
    # 404 görüyordu. THE_REQUEST istemcinin gönderdiği ham istektir; içeriden
    # demos/ altına yapılan yeniden yazmadan etkilenmez.
    RewriteCond %{THE_REQUEST} !\s/+(ci4/)?kutuphane/uygulama/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ $1 [R=301,L]

    # Kurulum sihirbazı kendi başına çalışır.
    RewriteCond %{REQUEST_URI} !kurulum/
    # Gerçek dosya ve klasörlere dokunma (assets/, upload/ …).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ---------------------------------------------------------------------
#  3) GÜVENLİK BAŞLIKLARI (yedek katman)
# ---------------------------------------------------------------------
#  PHP zaten bu başlıkları gönderiyor (App\Core\Response). Buradaki
#  tanımlar, PHP çalışmadan servis edilen statik dosyaları da kapsar.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------
#  4) İSTEMCİ ÖNBELLEĞİ (statik dosyalar)
# ---------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------
#  5) SIKIŞTIRMA
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
