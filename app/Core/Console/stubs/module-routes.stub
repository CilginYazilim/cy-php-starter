declare(strict_types=1);

use App\Core\Router;
use Modules\{{AD}}\Controllers\{{AD}}Controller;

/** @var Router $router */

$router->get('panel/{{SLUG}}', {{AD}}Controller::class, 'index',
    ['installed', 'auth', 'can:{{TABLO}}.view']);

