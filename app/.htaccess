# Uygulama koduna doğrudan tarayıcı erişimi yasaktır.
# Bu klasördeki PHP dosyaları yalnızca kökteki index.php tarafından
# dahil edilmek üzere yazılmıştır.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
