# Yükleme klasöründe sunucu tarafı kod çalıştırılmasını engeller.
# Zararlı bir dosyanın yüklenmesi durumunda dahi çalıştırılamaz.

php_flag engine off

<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|phar|pl|py|cgi|asp|aspx|sh|shtml)$">
    Require all denied
</FilesMatch>
