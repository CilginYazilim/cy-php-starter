# =====================================================================
#  .env.example — Ortam değişkenleri şablonu
#  cilginyazilim.com – PHP Başlangıç Şablonu
# ---------------------------------------------------------------------
#  Bu dosyayı ELLE kullanmak isterseniz ".env" olarak kopyalayıp
#  değerleri doldurun:
#
#    cp .env.example .env
#
#  Daha kolay yol: tarayıcıda install.php dosyasını açın, sihirbaz bu
#  dosyayı sizin için otomatik oluşturur.
#
#  ".env" dosyası .gitignore içindedir — Git'e asla gönderilmez.
#  Bu yüzden şifrenizi güvenle buraya (yani .env'e) yazabilirsiniz.
# =====================================================================

APP_NAME="Yeni Proje"
APP_DESCRIPTION="Çılgın Yazılım örnek uygulaması"

DB_HOST=127.0.0.1
DB_NAME=yeni_proje
DB_USER=root
DB_PASS=

# Canlı ortamda "false" yapın.
APP_DEBUG=true
