# =====================================================================
#  ORTAM DEĞİŞKENLERİ – ÖRNEK DOSYA
# ---------------------------------------------------------------------
#  BU DOSYAYI ELLE DOLDURMANIZA GEREK YOK: "kurulum/" klasöründeki
#  sihirbazı çalıştırın, ".env" dosyasını sizin için üretir.
#
#  Elle kurulum yapıyorsanız bu dosyayı ".env" adıyla kopyalayın.
#  ".env" dosyası .gitignore içindedir; asla depoya gönderilmez.
#
#  ÖZEL KARAKTERLİ DEĞERLER (boşluk, #, ", $, \) çift tırnak içinde
#  yazılır; tırnak içinde \" \\ \$ \n kaçışları geçerlidir.
#      DB_PASS="Pa\$\$w0rd#1"
# =====================================================================

APP_NAME="Yeni Proje"
APP_DESCRIPTION="Çılgın Yazılım örnek Starter uygulaması"
APP_URL=

# --- Ortam ----------------------------------------------------------
#  APP_ENV: local | production
#  Varsayılan YAYIN modudur: satır hiç yoksa production + debug kapalı
#  kabul edilir. Yalnızca kendi bilgisayarınızda local + true yapın.
#  İkisi çelişirse (production + debug) güvenlik kanalına uyarı düşer.
APP_ENV=production
APP_DEBUG=false

#  Kuruluma özel gizli anahtar (64 onaltılık karakter). Oturumları bu
#  kuruluma bağlar. Üretmek için:
#      php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

APP_PRETTY_URLS=true
APP_TIMEZONE=Europe/Istanbul

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yeni_proje
DB_USER=root
DB_PASS=

# --- Oturum ---------------------------------------------------------
#  SESSION_NAME: Çerez adı — aynı alan adında birden fazla kurulum
#  varsa her biri FARKLI olmalı (yalnızca harf, rakam, _). Boşsa
#  kuruluma özel bir ad üretilir.
#  SESSION_PATH: Oturum dosyalarının klasörü. Satır yoksa
#  storage/sessions kullanılır; "SESSION_PATH=" (boş) PHP'nin sistem
#  klasörüne döner (Redis/Memcached kullanan sunucular için).
SESSION_NAME=
SESSION_IDLE_TIMEOUT=1800

# --- Giriş ve kayıt koruması ----------------------------------------
#  Kimlik+IP başına hatalı deneme sınırı ve kilit süresi (saniye).
#  LOGIN_IP_MAX_ATTEMPTS: tek IP'den FARKLI hesaplara deneme sınırı
#  (parola püskürtme). Ofis/okul gibi IP paylaşan yerlerde yükseltin.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=900
LOGIN_IP_MAX_ATTEMPTS=30
REGISTER_MAX_PER_HOUR=5

# --- Yüklemeler -----------------------------------------------------
#  UPLOAD_MAX_PIXELS: genişlik × yükseklik sınırı ("görsel bombası").
UPLOAD_MAX_MB=2
UPLOAD_MAX_PIXELS=25000000

# --- Günlük kayıtları (storage/logs) --------------------------------
#  LOG_LEVEL: debug | info | warning | error | critical
#  Eşiğin ALTINDAKİ kayıtlar hiç yazılmaz. Yayında "info" önerilir.
LOG_ENABLED=true
LOG_LEVEL=info
LOG_DAYS=30

# --- Önbellek -------------------------------------------------------
#  CACHE_DRIVER: dosya | veritabani | kapali
#    dosya       storage/cache/data (varsayılan, kurulum gerektirmez)
#    veritabani  "onbellek" tablosu — çok sunuculu kurulumlar için
#                (önce: php cy migrate)
#    kapali      hiçbir şey saklamaz (hata ararken işe yarar; DİKKAT:
#                API ve kayıt formu hız sınırları da devre dışı kalır)
#
#  CACHE_PREFIX: Aynı klasörü/veritabanını paylaşan projeler
#  birbirinin verisini okumasın diye her projeye kendi öneğini verin.
CACHE_DRIVER=dosya
CACHE_TTL=3600
CACHE_PREFIX=cy
