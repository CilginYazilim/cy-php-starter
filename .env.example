# =====================================================================
#  ORTAM DEĞİŞKENLERİ – ÖRNEK DOSYA
# ---------------------------------------------------------------------
#  BU DOSYAYI ELLE DOLDURMANIZA GEREK YOK: "kurulum/" klasöründeki
#  sihirbazı çalıştırın, ".env" dosyasını sizin için üretir.
#
#  Elle kurulum yapıyorsanız bu dosyayı ".env" adıyla kopyalayın.
#  ".env" dosyası .gitignore içindedir; asla depoya gönderilmez.
#
#  Kodun okuduğu HER anahtar burada yazar. "#" ile başlayan anahtarlar
#  isteğe bağlıdır; yazılan değer, satır hiç yokken kullanılan
#  varsayılandır.
#
#  ÖZEL KARAKTERLİ DEĞERLER (boşluk, #, ", $, \) çift tırnak içinde
#  yazılır; tırnak içinde \" \\ \$ \n kaçışları geçerlidir.
#      DB_PASS="Pa\$\$w0rd#1"
# =====================================================================

APP_NAME="Yeni Proje"
APP_DESCRIPTION="Çılgın Yazılım örnek Starter uygulaması"
APP_URL=

# --- Ortam ----------------------------------------------------------
#  APP_ENV: local | production
#  Varsayılan YAYIN modudur: satır hiç yoksa production + debug kapalı
#  kabul edilir. Yalnızca kendi bilgisayarınızda local + true yapın.
#  İkisi çelişirse (production + debug) güvenlik kanalına uyarı düşer;
#  debug açık site yerel bir adresten açılmıyorsa panelin her
#  sayfasında kırmızı uyarı çıkar.
APP_ENV=production
APP_DEBUG=false

#  Kuruluma özel gizli anahtar (64 onaltılık karakter). Oturumları,
#  "beni hatırla" ve güvenilen cihaz çerezlerini, e-posta doğrulama
#  bağlantılarını ve form zaman damgalarını bu kuruluma bağlar.
#  Doluyken kurulum kimliği YALNIZCA bundan türetilir (klasör yolundan
#  değil); her dağıtımı yeni klasöre açan araçlarda oturumlar düşmez.
#  Başka bir kuruluma KOPYALAMAYIN. Üretmek için:
#      php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

APP_PRETTY_URLS=true
APP_TIMEZONE=Europe/Istanbul

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yeni_proje
DB_USER=root
DB_PASS=

# --- Oturum ---------------------------------------------------------
#  SESSION_NAME: Çerez adı — aynı alan adında birden fazla kurulum
#  varsa her biri FARKLI olmalı (yalnızca harf, rakam, _). Boşsa
#  kuruluma özel bir ad üretilir.
#  SESSION_PATH: Oturum dosyalarının klasörü. Satır yoksa
#  storage/sessions kullanılır; "SESSION_PATH=" (boş) PHP'nin sistem
#  klasörüne döner. Sunucu oturumları Redis/Memcached'de tutuyorsa
#  (session.save_handler) bu ayar zaten yok sayılır.
#  SESSION_REGENERATE: oturum kimliği kaç saniyede bir yenilensin.
SESSION_NAME=
SESSION_IDLE_TIMEOUT=1800
# SESSION_PATH=
# SESSION_REGENERATE=900

# --- Giriş ve kayıt koruması ----------------------------------------
#  LOGIN_MAX_ATTEMPTS / LOGIN_LOCKOUT: aynı kimliğe, aynı IP'den (ya da
#  aynı güvenilen cihazdan) bu kadar hatalı denemede bu kadar saniye
#  kilit. LOGIN_WINDOW: denemelerin sayıldığı pencere (saniye).
#
#  LOGIN_IP_MAX_ATTEMPTS: tek IP'den bu kadar FARKLI kimlik denenince
#  giderek artan bekleme başlar (1, 2, 4… saniye; en fazla
#  LOGIN_LOCKOUT). IPv6 /64 bloğu tek adres sayılır. Daha önce bu
#  hesaba giriş yapmış tarayıcı bu yavaşlatmaya takılmaz. 0 → kapalı.
#
#  REGISTER_MAX_PER_HOUR: bir IP'den saatte en fazla kaç yeni hesap.
#  REGISTER_MAX_ATTEMPTS_PER_HOUR: kayıt formuna saatte en fazla kaç
#  GÖNDERİM (hatalılar dahil).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT=900
# LOGIN_WINDOW=900
LOGIN_IP_MAX_ATTEMPTS=30
REGISTER_MAX_PER_HOUR=5
REGISTER_MAX_ATTEMPTS_PER_HOUR=20

# --- Güvenilen vekiller ---------------------------------------------
#  Site Cloudflare, yük dengeleyici ya da ters vekil (nginx) arkasındaysa
#  vekillerin adreslerini/aralıklarını yazın. Yazılmazsa bütün
#  ziyaretçiler vekilin IP'sinden geliyor görünür: tek bir saldırgan
#  giriş yavaşlatmasını HERKES için tetikler.
#  Başlık yalnızca istek listedeki bir vekilden geldiyse okunur.
#      TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
#      TRUSTED_PROXY_HEADER=CF-Connecting-IP      (Cloudflare için)
TRUSTED_PROXIES=
# TRUSTED_PROXY_HEADER=X-Forwarded-For

# --- Yüklemeler -----------------------------------------------------
#  UPLOAD_MAX_PIXELS: genişlik × yükseklik sınırı ("görsel bombası").
UPLOAD_MAX_MB=2
UPLOAD_MAX_PIXELS=25000000

# --- REST API (/api/v1/…) -------------------------------------------
#  Anahtar (ya da IP) başına pencerede en fazla kaç istek.
# API_RATE_LIMIT=120
# API_RATE_WINDOW=60

# --- İş kuyruğu (php cy queue:work) ---------------------------------
#  QUEUE_TIMEOUT: bu kadar saniyedir "çalışıyor"da duran iş, işçisi
#  çökmüş sayılıp yeniden kuyruğa alınır (hakkı bittiyse başarısız).
#  QUEUE_MAX_JOBS: işçi bir çalıştırmada en fazla kaç iş yapsın.
# QUEUE_TIMEOUT=300
# QUEUE_MAX_JOBS=25

# --- Olaylar --------------------------------------------------------
#  Açıkken bir dinleyicinin hatası fırlatılır (geliştirmede yararlı);
#  kapalıyken log'a yazılıp devam edilir. Varsayılan: APP_DEBUG.
# EVENTS_STRICT=false

# --- İçerik Güvenliği Politikası (CSP) ------------------------------
#  Politikayı KAPATMAYIN; bir dış servis engellenirse yalnızca onun
#  adresini ekleyin (birden fazlası virgülle).
# CSP_ENABLED=true
# CSP_SCRIPT_SRC=https://js.stripe.com
# CSP_STYLE_SRC=
# CSP_IMG_SRC=
# CSP_CONNECT_SRC=
# CSP_FRAME_SRC=https://js.stripe.com
# CSP_FONT_SRC=

# --- Günlük kayıtları (storage/logs) --------------------------------
#  LOG_LEVEL: debug | info | warning | error | critical
#  Eşiğin ALTINDAKİ kayıtlar hiç yazılmaz. Yayında "info" önerilir.
LOG_ENABLED=true
LOG_LEVEL=info
LOG_DAYS=30

# --- Önbellek -------------------------------------------------------
#  CACHE_DRIVER: dosya | veritabani | kapali
#    dosya       storage/cache/data (varsayılan, kurulum gerektirmez)
#    veritabani  "onbellek" tablosu — çok sunuculu kurulumlar için
#    kapali      hiçbir şey saklamaz (hata ararken işe yarar)
#  Hız sınırları önbellekte DEĞİL, storage/cache/hiz altındaki kilitli
#  dosyalarda tutulur; önbelleği kapatmak onları etkilemez.
#
#  CACHE_PREFIX: Aynı klasörü/veritabanını paylaşan projeler
#  birbirinin verisini okumasın diye her projeye kendi öneğini verin.
CACHE_DRIVER=dosya
CACHE_TTL=3600
CACHE_PREFIX=cy
