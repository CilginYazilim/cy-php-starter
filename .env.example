# =====================================================================
#  ORTAM DEĞİŞKENLERİ – ÖRNEK DOSYA
# ---------------------------------------------------------------------
#  BU DOSYAYI ELLE DOLDURMANIZA GEREK YOK: "kurulum/" klasöründeki
#  sihirbazı çalıştırın, ".env" dosyasını sizin için üretir.
#
#  Elle kurulum yapıyorsanız bu dosyayı ".env" adıyla kopyalayın.
#  ".env" dosyası .gitignore içindedir; asla depoya gönderilmez.
# =====================================================================

APP_NAME=Yeni Proje
APP_DESCRIPTION=Çılgın Yazılım örnek Satarter uygulaması
APP_URL=

# --- Ortam ----------------------------------------------------------
#  APP_ENV: local | production
#  Yayına alırken APP_ENV=production VE APP_DEBUG=false yapın.
#  İkisi çelişirse (production + debug) güvenlik kanalına uyarı düşer.
APP_ENV=local
APP_DEBUG=true

APP_PRETTY_URLS=true
APP_TIMEZONE=Europe/Istanbul

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=yeni_proje
DB_USER=root
DB_PASS=

# --- Günlük kayıtları (storage/logs) --------------------------------
#  LOG_LEVEL: debug | info | warning | error | critical
#  Eşiğin ALTINDAKİ kayıtlar hiç yazılmaz. Yayında "info" önerilir.
LOG_ENABLED=true
LOG_LEVEL=debug
LOG_DAYS=30

# --- Önbellek -------------------------------------------------------
#  CACHE_DRIVER: dosya | veritabani | kapali
#    dosya       storage/cache/data (varsayılan, kurulum gerektirmez)
#    veritabani  "onbellek" tablosu — çok sunuculu kurulumlar için
#                (önce: php cy migrate)
#    kapali      hiçbir şey saklamaz (hata ararken işe yarar)
#
#  CACHE_PREFIX: Aynı klasörü/veritabanını paylaşan projeler
#  birbirinin verisini okumasın diye her projeye kendi öneğini verin.
CACHE_DRIVER=dosya
CACHE_TTL=3600
CACHE_PREFIX=cy
